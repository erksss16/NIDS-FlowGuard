# Configuration reference only: scripts/backend do NOT automatically load .env.
# In PowerShell set values with: $env:NIDS_AI_PROVIDER = "local"
NIDS_DB_BACKEND=sqlite
NIDS_SQLITE_PATH=data/ssf.sqlite3
NIDS_DEFAULT_USER=admin
NIDS_DEFAULT_PASSWORD=replace-with-your-local-password
NIDS_DEFAULT_EMAIL=admin@example.com
NIDS_AI_PROVIDER=local
NIDS_AI_API_URL=https://api.example.com/v1/chat/completions
NIDS_AI_MODEL=your-model
NIDS_AI_API_KEY=
NIDS_SMTP_HOST=
NIDS_SMTP_PORT=587
NIDS_SMTP_TLS=1
NIDS_SMTP_USER=
NIDS_SMTP_PASSWORD=
NIDS_SMTP_FROM=
